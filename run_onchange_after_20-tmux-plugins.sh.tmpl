#!/bin/bash
# install tmux plugins whenever tmux.conf changes (tpm itself comes from homebrew)
# tmux.conf hash: {{ include "dot_config/tmux/tmux.conf" | sha256sum }}
set -euo pipefail

tpm=/opt/homebrew/opt/tpm/share/tpm/bin/install_plugins
if [[ ! -x $tpm ]]; then
  echo "tpm not installed - skipping tmux plugins" >&2
  exit 0
fi
"$tpm"
