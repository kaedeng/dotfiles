#!/bin/bash
# re-runs whenever the Brewfile changes
# Brewfile hash: {{ include "Brewfile" | sha256sum }}
set -euo pipefail

if [[ ! -x /opt/homebrew/bin/brew ]]; then
  echo "homebrew not installed - skipping brew bundle (see README)" >&2
  exit 0
fi
eval "$(/opt/homebrew/bin/brew shellenv)"

brew trust asmvik/formulae 2>/dev/null || true
brew bundle --no-upgrade --file={{ joinPath .chezmoi.sourceDir "Brewfile" | quote }}
